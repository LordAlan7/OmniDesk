# Copia este archivo a apps/api/.env  (NUNCA subas el .env real a GitHub)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Obligatorio en producción. En desarrollo hay un valor por defecto inseguro.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Seguridad (NFR-002). Ver docs/SECURITY.md
BCRYPT_COST=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
# Proxies de confianza delante de la API (1 en producción tras un reverse proxy)
TRUST_PROXY=0

# PostgreSQL administrado (aún no se usa: los repositorios son en memoria)
DATABASE_URL=postgresql://user:password@localhost:5432/omnidesk

# Módulo de IA (opcional hasta la fase 4)
OPENAI_API_KEY=

# Adaptadores externos (NFR-007). 'mock' / 'memory' no llaman a servicios reales.
AI_PROVIDER=mock
STORAGE_PROVIDER=memory

# Pool de conexiones PostgreSQL (NFR-008). Ver docs/NFR-008-Scalability.md
# Máximo de conexiones por instancia de la API. Default: 10.
# Cálculo: num_instancias × DB_POOL_MAX ≤ max_connections del servidor PG.
DB_POOL_MAX=10
# Timeout de conexión en milisegundos. Si la BD no responde, falla rápido.
DB_CONNECTION_TIMEOUT_MS=30000
