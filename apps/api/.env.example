# Copia este archivo a apps/api/.env  (NUNCA subas el .env real a GitHub)
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Obligatorio en producción. En desarrollo hay un valor por defecto inseguro.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Seguridad (NFR-002). Ver docs/SECURITY.md
BCRYPT_COST=12
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
# Proxies de confianza delante de la API (1 en producción tras un reverse proxy)
TRUST_PROXY=0

# PostgreSQL administrado (aún no se usa: los repositorios son en memoria)
DATABASE_URL=postgresql://user:password@localhost:5432/omnidesk

# Módulo de IA (opcional hasta la fase 4)
OPENAI_API_KEY=
# Consultas al asistente por usuario (control de costo del proveedor de IA)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10

# Adaptadores externos (NFR-007). 'mock' / 'memory' no llaman a servicios reales.
AI_PROVIDER=mock
# Con AI_PROVIDER=openai: modelo y dirección de la API (compatible con OpenAI). Ejemplo para Gemini:
#   AI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_OPENAI_MODEL=<modelo de Gemini>   OPENAI_API_KEY=<clave de Google AI Studio>
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENAI_MODEL=gpt-4o-mini
STORAGE_PROVIDER=memory

# Pool de conexiones PostgreSQL (NFR-008). Ver docs/NFR-008-Scalability.md
# Máximo de conexiones por instancia de la API. Default: 10.
# Cálculo: num_instancias × DB_POOL_MAX ≤ max_connections del servidor PG.
DB_POOL_MAX=10
# Timeout de conexión en milisegundos. Si la BD no responde, falla rápido.
DB_CONNECTION_TIMEOUT_MS=30000

# Integración con la API de Inventario (contrato v1.1). 'mock' no llama al servicio real.
INVENTORY_PROVIDER=mock
# En producción debe ser https:// (la API no arranca con http://).
INVENTORY_API_URL=http://localhost:3001
# Credencial del dispositivo "support-backend". Solo en el backend; nunca en el frontend ni en Git.
# Debe tener VEHICLE_READ, PRODUCT_READ, WARRANTY_READ y VEHICLE_MODEL_READ, y NO CUSTOMER_DATA_READ.
INVENTORY_API_CREDENTIAL=
INVENTORY_TIMEOUT_MS=5000
INVENTORY_MAX_RETRIES=1
INVENTORY_CIRCUIT_THRESHOLD=5
INVENTORY_CIRCUIT_RESET_MS=30000
INVENTORY_CACHE_MODELS_TTL_S=600
INVENTORY_CACHE_COMPAT_TTL_S=300
INVENTORY_CACHE_ENTITY_TTL_S=60
INVENTORY_LOW_STOCK_THRESHOLD=5
# Registro de llamadas salientes (ruta, estado, latencia, requestId). Activo por defecto salvo en pruebas.
INVENTORY_LOG_CALLS=true